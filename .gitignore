# ---------------------------------------------------------------------------
# Entivio .gitignore
#
# Rule: secrets never enter this repository. See ENTIVIO_BUILD_SPEC.md §8, §9.
# If you are about to add an exception here, stop and ask first.
# ---------------------------------------------------------------------------

# --- Environment / secrets (NEVER COMMIT) ---
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
*.env.local

# --- Wallet / keys / recovery material (NEVER COMMIT) ---
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
wallet/
wallets/
*.mnemonic
*.seed
recovery-phrase*
recovery_phrase*
private-key*
private_key*

# --- Local SQLite / db files ---
*.sqlite
*.sqlite3
*.db

# --- Node ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Daml / DPM build output ---
.daml/
.dpm/
*.dar
*.dalf
daml/*/target/

# --- Vercel ---
.vercel

# --- Test output ---
coverage/
playwright-report/
test-results/
*.lcov

# --- Logs / temp ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# --- Private notes (keep local) ---
NOTES.md
notes/
private/
*.private.md
*.local.md

# --- Editor / OS ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
