# ---------------------------------------------------------------------------
# Entivio environment template
#
# NAMES ONLY. Never put real values in this file.
# Copy this to .env.local and fill in real values there. .env.local is
# gitignored and must never be committed or pushed.
#
# Production values live in Vercel environment settings.
# ---------------------------------------------------------------------------

# --- Canton / DevNet connection ---
# Filled in once HackCanton/NODERS grant DevNet access.
CANTON_LEDGER_API_URL=
CANTON_LEDGER_ID=
CANTON_AUTH_TOKEN_URL=
CANTON_AUTH_CLIENT_ID=
CANTON_AUTH_CLIENT_SECRET=

# --- Entivio parties ---
# Real party IDs from the provisioned environment. Not from examples.
ENTIVIO_ADMIN_PARTY=
ENTIVIO_POLICYHOLDER_PARTY=
ENTIVIO_REPAIR_PROVIDER_PARTY=
ENTIVIO_RENTAL_PROVIDER_PARTY=

# --- Settlement asset ---
# Only set after availability is verified. Do not assume CC or USDCx exist.
ENTIVIO_SETTLEMENT_ASSET=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
